{
  "id": "quick_ref_tables",
  "title": "PyTorch Cheatsheet: Production Tables",
  "name": "PyTorch Cheatsheet: Production Tables",
  "slug": "quick-ref-tables",
  "description": "Fast reference tables for PyTorch tensor creation, shape operations, memory behavior, device transfers, data types, training modes, and export formats.",
  "category": "cheatsheet",
  "package": "pytorch",
  "package_reference": "pytorch",
  "version": "2.13.0",
  "last_updated": "2026-07-23",
